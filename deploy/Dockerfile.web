# Novo Labvie — Web (React/Vite) servida por nginx — PONTO DE PARTIDA, NÃO TESTADO.
#
# ATENÇÃO: VITE_API_URL é build-time. Passe a URL pública da API como build-arg:
#   docker build -f deploy/Dockerfile.web --build-arg VITE_API_URL=https://api.seu-dominio.com -t labvie-web .

FROM node:22-slim AS build
WORKDIR /app
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
COPY package.json package-lock.json ./
COPY packages/domain/package.json packages/domain/
COPY packages/agents/package.json packages/agents/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci
COPY . .
RUN npm run build -w @labvie/web

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
