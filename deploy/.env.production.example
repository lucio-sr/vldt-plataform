# Copie este arquivo para .env na VM e substitua todos os valores marcados.
NODE_ENV=production
API_PORT=3001

# Domínios públicos: devem apontar para o IP da VM antes de subir o Caddy.
WEB_DOMAIN=app.exemplo.com
API_DOMAIN=api.exemplo.com
WEB_ORIGIN=https://app.exemplo.com
VITE_API_URL=https://api.exemplo.com

# Use valores longos e exclusivos. Não exponha este arquivo nem a porta do banco.
POSTGRES_USER=labvie
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
POSTGRES_DB=labvie
DATABASE_URL=postgresql://labvie:TROQUE_POR_UMA_SENHA_FORTE@db:5432/labvie

REDIS_URL=redis://redis:6379

BETTER_AUTH_SECRET=TROQUE_POR_UMA_CHAVE_ALEATORIA_LONGA
BETTER_AUTH_URL=https://api.exemplo.com

S3_ENDPOINT=
S3_REGION=sa-east-1
S3_BUCKET=labvie-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
