# Novo Labvie — API (NestJS + worker) — PONTO DE PARTIDA, NÃO TESTADO.
#
# IMPORTANTE: os pacotes @labvie/domain e @labvie/agents são consumidos como
# TypeScript CRU (main aponta para src/index.ts). Por isso `node dist/main.js`
# NÃO funciona sem passo extra — a API só sobe hoje via tsx. Este Dockerfile
# roda em produção via tsx (o mesmo caminho já provado a bootar, só sem --watch).
# Alternativa mais "correta" no futuro: bundlar com esbuild para um único .js.

FROM node:22-slim AS base
WORKDIR /app

# 1) instalar deps do monorepo inteiro (workspaces)
COPY package.json package-lock.json ./
COPY packages/domain/package.json packages/domain/
COPY packages/agents/package.json packages/agents/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci

# 2) copiar o código
COPY . .

ENV NODE_ENV=production
ENV API_PORT=3001
ENV QUEUE_ENABLED=true
EXPOSE 3001

# Roda a API+worker via tsx (sem watch). O diretório da API é necessário para
# que o tsx encontre apps/api/tsconfig.json, que habilita decorators do NestJS.
# As migrations devem rodar ANTES (ver deploy/README.md).
CMD ["sh", "-c", "cd apps/api && node --import tsx src/main.ts"]
