# ---- API ----
NODE_ENV=development
API_PORT=3001

# ---- Postgres (pgvector) ----
# região BR recomendada (LGPD / funding público) — ADR 0002 §3.6
DATABASE_URL=postgresql://labvie:labvie@localhost:5432/labvie

# ---- Auth (Better Auth) ----
BETTER_AUTH_SECRET=change-me-in-prod
BETTER_AUTH_URL=http://localhost:3001
# origem do front-end (CORS + cookies + trustedOrigins)
WEB_ORIGIN=http://localhost:5173

# ---- Redis (BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Storage (S3-compatível) ----
S3_ENDPOINT=
S3_REGION=sa-east-1
S3_BUCKET=labvie-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- LLM (mix por papel — ADR 0002 §3.4) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# embeddings: dimensão do schema (vector(1536)) assume text-embedding-3-small
EMBEDDING_MODEL=text-embedding-3-small

# ---- Web ----
VITE_API_URL=http://localhost:3001
